# --- LLM (agent brain). Leave blank to use the deterministic fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Set to 0 to force the fallback even if a key is present
RECOVERAI_USE_LLM=1

# --- Payment provider: "simulated" (default) or "razorpay" (test mode only)
RECOVERAI_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

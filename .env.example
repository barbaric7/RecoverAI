# --- LLM (agent brain). Leave blank to use the deterministic fallback.
# OpenAI key (sk-...) or OpenRouter key (sk-or-v1-...; base URL + model are auto-detected)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=gpt-4o-mini        # or openai/gpt-4.1 via OpenRouter
# Set to 0 to force the fallback even if a key is present
RECOVERAI_USE_LLM=1

# --- Payment provider: "simulated" (default) or "razorpay" (test mode only)
RECOVERAI_PROVIDER=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: hybrid mode for tight API budgets (LLM on N prioritized cases, fallback on the rest)
# LLM_SAMPLE=40
# LLM_CONCURRENCY=2
